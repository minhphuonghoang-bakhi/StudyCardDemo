<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.studycarddemo.UI.StudyModeController">

    <top>
        <VBox spacing="5" styleClass="header">
            <padding><Insets top="15" right="15" bottom="10" left="15"/></padding>
            <HBox spacing="15">
                <Button text="← Back" onAction="#onBack"/>
                <Label fx:id="setNameLabel" text="Studying:" styleClass="title"/>
            </HBox>
            <Label fx:id="progressLabel" text="" styleClass="subtitle"/>
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="30">
            <padding><Insets top="20" right="40" bottom="20" left="40"/></padding>

            <VBox alignment="CENTER" spacing="20" maxWidth="600"
                  styleClass="card-display" VBox.vgrow="ALWAYS">
                <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>
                <Label text="Question:" styleClass="section-label"/>
                <Label fx:id="questionLabel" wrapText="true" styleClass="card-question"
                       alignment="CENTER" textAlignment="CENTER"/>

                <Separator/>

                <Label fx:id="answerLabel" wrapText="true" styleClass="card-answer"
                       alignment="CENTER" textAlignment="CENTER" visible="false"/>
            </VBox>

            <Label fx:id="resultLabel" text="" styleClass="result-label"/>

            <HBox alignment="CENTER" spacing="15">
                <Button fx:id="revealButton" text="Show Answer"
                        onAction="#onReveal" styleClass="primary-button"
                        prefWidth="160"/>
                <Button fx:id="unknownButton" text="✗ Didn't Know"
                        onAction="#onUnknown" disable="true"
                        styleClass="danger-button" prefWidth="160"/>
                <Button fx:id="knownButton" text="✓ Knew It"
                        onAction="#onKnown" disable="true"
                        styleClass="success-button" prefWidth="160"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>