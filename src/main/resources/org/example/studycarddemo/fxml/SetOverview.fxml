<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.studycarddemo.UI.SetOverviewController">

    <top>
        <VBox spacing="5" styleClass="header">
            <padding><Insets top="15" right="15" bottom="10" left="15"/></padding>
            <Label text="Study Cards" styleClass="title"/>
        </VBox>
    </top>

    <center>
        <HBox spacing="15">
            <padding><Insets top="0" right="15" bottom="15" left="15"/></padding>

            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <Label text="Your study sets:"/>
                <ListView fx:id="setListView" VBox.vgrow="ALWAYS"/>
            </VBox>

            <VBox spacing="10" prefWidth="280">
                <Label text="Description:" styleClass="section-label"/>
                <Label fx:id="descriptionLabel" wrapText="true" styleClass="description"/>

                <Separator/>

                <Button fx:id="studyButton" text="Start Study Session"
                        onAction="#onStudy" disable="true" maxWidth="Infinity"
                        styleClass="primary-button"/>
                <Button fx:id="editCardsButton" text="Edit Cards"
                        onAction="#onEditCards" disable="true" maxWidth="Infinity"/>

                <Separator/>

                <Label text="Set actions:" styleClass="section-label"/>
                <Button text="New Set" onAction="#onCreateSet" maxWidth="Infinity"/>
                <Button fx:id="editSetButton" text="Edit Set"
                        onAction="#onEditSet" disable="true" maxWidth="Infinity"/>
                <Button fx:id="deleteSetButton" text="Delete Set"
                        onAction="#onDeleteSet" disable="true" maxWidth="Infinity"
                        styleClass="danger-button"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>